        <mxCell id="l5ATTywDcrNS45W6atCO-18" value="&lt;span style=&quot;text-align: left; white-space-collapse: preserve-breaks;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;i&gt;Внутренние:&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve-breaks;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;- данные crm&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve-breaks;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;- информация от УК&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve-breaks;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="Gr0Zq-AI6Quabplr0KPa-179">
